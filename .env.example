# Barventis Environment Variables Example

# Gemini API Key (Server-side AI Recipe Analysis)
GEMINI_API_KEY=

# Supabase Credentials (Client-side and Server-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Port
PORT=3000
NODE_ENV=development
