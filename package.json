{
  "name": "fieldwork-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fieldwork \u2014 Operational & Commercial Management Platform (frontend)",
  "scripts": {
    "dev": "tsx backend-src/server.ts",
    "build": "vite build && esbuild backend-src/server.ts --bundle --platform=node --format=cjs --external:pg --external:pg-native --external:express --external:helmet --external:express-rate-limit --external:multer --external:dotenv --external:@supabase/supabase-js --minify --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx backend-src/db/migrate.ts",
    "db:seed": "tsx backend-src/db/seed.ts",
    "pdf:samples": "bash scripts/build-run.sh scripts/render-samples.ts && bash scripts/build-run.sh scripts/render-visit-sample.ts",
    "test:integration": "tsx scripts/integration-test.mts",
    "test:templates": "bash scripts/build-run.sh scripts/template-test.ts",
    "test:shim": "bash scripts/run-shim-test.sh",
    "test:whitebox": "tsx tests/whitebox.test.ts",
    "test:blackbox": "tsx tests/blackbox.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/supabase-js": "^2.47.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.104.1",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^11.18.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "multer": "^2.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.89.0",
    "react-is": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
